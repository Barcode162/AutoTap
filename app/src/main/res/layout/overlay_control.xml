<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/controlRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- Collapsed bubble -->
    <TextView
        android:id="@+id/bubble"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_bubble"
        android:gravity="center"
        android:text="TAP"
        android:textColor="#0B0F14"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Expanded panel -->
    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_panel"
        android:padding="14dp"
        android:minWidth="260dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/dragHandle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="AutoTap  ⠿"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/btnCollapse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="–"
                android:textColor="@color/onSurface"
                android:textSize="22sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <TextView
                android:id="@+id/btnClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="×"
                android:textColor="@color/onSurfaceDim"
                android:textSize="20sp"
                android:paddingStart="8dp"
                android:paddingEnd="2dp" />
        </LinearLayout>

        <!-- Mode segmented -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/btnModeToggle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Toggle"
                android:gravity="center"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:textColor="@color/bg"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_primary" />

            <TextView
                android:id="@+id/btnModeHold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Hold"
                android:gravity="center"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:textColor="@color/onSurface"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_btn_secondary" />
        </LinearLayout>

        <!-- CPS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Speed"
                android:textColor="@color/onSurfaceDim"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/cpsValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="10 CPS"
                android:textColor="@color/onSurface"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/cpsSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="49"
            android:progress="9"
            android:layout_marginTop="2dp" />

        <!-- Dots -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/btnAddDot"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="+ Dot"
                android:gravity="center"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:textColor="@color/onSurface"
                android:textSize="13sp"
                android:background="@drawable/bg_btn_secondary" />

            <TextView
                android:id="@+id/btnRemoveDot"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="– Dot"
                android:gravity="center"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:textColor="@color/onSurface"
                android:textSize="13sp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_btn_secondary" />

            <TextView
                android:id="@+id/dotCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:gravity="center"
                android:minWidth="32dp"
                android:textColor="@color/onSurfaceDim"
                android:textSize="13sp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Action: START/STOP (toggle) -->
        <TextView
            android:id="@+id/btnStartStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="START"
            android:gravity="center"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:textColor="@color/bg"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_primary"
            android:layout_marginTop="14dp" />

        <!-- Action: HOLD pad (hold mode) -->
        <TextView
            android:id="@+id/btnHoldPad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HOLD TO CLICK"
            android:gravity="center"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:textColor="@color/onSurface"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_secondary"
            android:layout_marginTop="14dp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
